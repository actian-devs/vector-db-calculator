{
  "name": "vector-db-calculator",
  "version": "1.0.0",
  "private": true,
  "description": "Sizing tool that recommends a vector storage tier for an agent or RAG workload.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "22.18.1",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "eslint": "9.36.0",
    "eslint-config-next": "^16.4.2",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
